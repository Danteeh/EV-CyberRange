[
    {
        "id": "ev-cyberrange-tab",
        "type": "tab",
        "label": "EV-CyberRange OCPP",
        "disabled": false,
        "info": "Dashboard for controlling OCPP Charge Points"
    },
    {
        "id": "ui-tab-main",
        "type": "ui_tab",
        "name": "Charge Points",
        "icon": "dashboard",
        "order": 1,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "ui-group-status",
        "type": "ui_group",
        "name": "System Status",
        "tab": "ui-tab-main",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "ui-group-cp1",
        "type": "ui_group",
        "name": "EVCR-001",
        "tab": "ui-tab-main",
        "order": 2,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "ui-group-cp2",
        "type": "ui_group",
        "name": "EVCR-002",
        "tab": "ui-tab-main",
        "order": 3,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "poll-charge-points",
        "type": "inject",
        "z": "ev-cyberrange-tab",
        "name": "Poll every 3s",
        "props": [],
        "repeat": "3",
        "crontab": "",
        "once": true,
        "onceDelay": "1",
        "topic": "",
        "x": 130,
        "y": 80,
        "wires": [["http-get-cps"]]
    },
    {
        "id": "http-get-cps",
        "type": "http request",
        "z": "ev-cyberrange-tab",
        "name": "GET Charge Points",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://evcr-backend:8000/api/ocpp/charge-points",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 330,
        "y": 80,
        "wires": [["parse-cp-status"]]
    },
    {
        "id": "parse-cp-status",
        "type": "function",
        "z": "ev-cyberrange-tab",
        "name": "Parse CP Status",
        "func": "const cps = msg.payload.charge_points || [];\n\n// Store in flow context\nflow.set('chargePoints', cps);\n\n// Send to status display\nconst statusText = cps.length > 0 \n    ? `${cps.length} Charge Points Connected`\n    : 'No Charge Points Connected';\n\nconst cp1 = cps.find(cp => cp.id === 'EVCR-001');\nconst cp2 = cps.find(cp => cp.id === 'EVCR-002');\n\nreturn [\n    { payload: statusText },\n    { payload: cp1 ? cp1.status : 'Disconnected' },\n    { payload: cp2 ? cp2.status : 'Disconnected' }\n];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 80,
        "wires": [["status-text"], ["cp1-status"], ["cp2-status"]]
    },
    {
        "id": "status-text",
        "type": "ui_text",
        "z": "ev-cyberrange-tab",
        "group": "ui-group-status",
        "order": 1,
        "width": 0,
        "height": 0,
        "name": "Connection Status",
        "label": "CSMS Status",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 770,
        "y": 40,
        "wires": []
    },
    {
        "id": "cp1-status",
        "type": "ui_text",
        "z": "ev-cyberrange-tab",
        "group": "ui-group-cp1",
        "order": 1,
        "width": 0,
        "height": 0,
        "name": "CP1 Status",
        "label": "Status",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 750,
        "y": 80,
        "wires": []
    },
    {
        "id": "cp2-status",
        "type": "ui_text",
        "z": "ev-cyberrange-tab",
        "group": "ui-group-cp2",
        "order": 1,
        "width": 0,
        "height": 0,
        "name": "CP2 Status",
        "label": "Status",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
